{
  "name": "pedestrian-paradise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "mkdir -p dist && wrangler pages dev --port 8788",
    "build": "tsc -b && vite build",
    "preview": "wrangler pages dev dist --port 8788",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pedestrian-paradise"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.66.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
