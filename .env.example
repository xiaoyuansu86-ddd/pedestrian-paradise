# === 前端（會被打包進瀏覽器，請在 Google Cloud 限制 HTTP referrer） ===
# Google Maps JavaScript API 金鑰；留空則自動退回 OSM（MapLibre）底圖
VITE_GOOGLE_MAPS_KEY=
# 選填：Google Maps 向量地圖 Map ID（啟用 3D 傾斜/自訂樣式需要）
VITE_GOOGLE_MAP_ID=

# === 伺服器端（Cloudflare Pages Functions 用；本機放 .dev.vars） ===
# 兩者都不要放在 .env，請用：
#   wrangler pages secret put GOOGLE_PLACES_KEY --project-name pedestrian-paradise
#   wrangler pages secret put ANTHROPIC_API_KEY --project-name pedestrian-paradise
